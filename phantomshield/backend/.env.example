# ==============================================================================
# PhantomShield (GraphShield AI) — Backend Environment Configuration
# hackFront India 2026 Hackathon | Neo4j Track - GraphOps Problem Statement
# ==============================================================================

# OPTION A: Neo4j AuraDB Cloud (Free-Tier Recommended for Cloud Deployment)
# Get your free instance at: https://neo4j.com/cloud/platform/aura-graph-database/
# Example AuraDB URI: neo4j+s://ab12cd34.databases.neo4j.io
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-auradb-generated-password>
NEO4J_DATABASE=neo4j

# OPTION B: Local Neo4j Instance / Docker Compose
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=phantomshield2026
# NEO4J_DATABASE=neo4j

# OPTION C: Zero-Downtime Fallback Mode
# If NEO4J_URI is unreachable or credentials are not provided,
# the backend automatically switches to its high-fidelity In-Memory Graph Engine.

# Server Port (Auto-injected by Render, Railway, or Heroku as $PORT)
PORT=8000

# Optional: Gemini API Key for Dynamic AI Deception Shell (Falls back to deterministic rules if omitted)
GEMINI_API_KEY=
